PROJECT_NAME=agent-template-pro
PROJECT_TYPE=java-maven
RUNTIME=java
RUNTIME_VERSION=21
HEALTHCHECK_URL=http://127.0.0.1:18400/actuator/health
PUBLIC_HEALTH_URL=https://manzhushaka.cn/gateway/agent-template-pro/health
JAVA_ARTIFACT=agent-boot/target/agent-boot-0.1.0-SNAPSHOT.jar
NODE_ENTRY=dist/server.js
NODE_EXTRA_PATHS=''
MAX_RELEASE_ARCHIVE_MIB=150
RELEASE_REQUIRED_FILES=deploy/agent-template-pro.locations.conf
REMOTE_RUNTIME_PATH=/home/codex-ops/JDKs/jdk-21/bin/java
REMOTE_REQUIRED_PATHS=''
REMOTE_REQUIRED_UNITS=personal-project@agent-template-pro.service
REMOTE_NGINX_PATHS=/home/middleware/nginx/conf/conf.d/agent-template-pro.locations.conf
REMOTE_MIN_FREE_MIB=512
REQUIRE_APP_ENV=true
STATIC_DIR=dist
