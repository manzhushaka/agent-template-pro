<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- 继承根 POM 的统一坐标、版本管理与构建默认配置。 -->
  <parent>
    <groupId>com.manzhushaka</groupId>
    <artifactId>agent-template-pro</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <!-- 组装全部应用层的可运行 Spring Boot 应用模块。 -->
  <artifactId>agent-boot</artifactId>
  <dependencies>
    <!-- 面向对话场景的 HTTP 接口。 -->
    <dependency>
      <groupId>com.manzhushaka</groupId>
      <artifactId>api-chat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 面向控制台场景的 HTTP 接口。 -->
    <dependency>
      <groupId>com.manzhushaka</groupId>
      <artifactId>api-console</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 具体技术集成与基础设施适配器。 -->
    <dependency>
      <groupId>com.manzhushaka</groupId>
      <artifactId>agent-infrastructure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 组装到应用中的 SPI 演示实现。 -->
    <dependency>
      <groupId>com.manzhushaka</groupId>
      <artifactId>agent-demo</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 生产环境健康检查与运维端点。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 测试依赖仅在当前模块测试类路径中生效。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>runtime-jdbc</id>
      <dependencies>
        <!-- 仅持久化部署启用数据源、Flyway 与 MySQL 驱动；默认 Demo 无中间件即可运行。 -->
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
          <groupId>org.flywaydb</groupId>
          <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
          <groupId>com.mysql</groupId>
          <artifactId>mysql-connector-j</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>model-openai</id>
      <dependencies>
        <dependency>
          <groupId>org.springframework.ai</groupId>
          <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
  <build>
    <plugins>
      <!-- 将当前组装模块重新打包为可执行的 Spring Boot 应用。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
