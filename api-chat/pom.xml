<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- 继承根 POM 的统一坐标、版本管理与构建默认配置。 -->
  <parent>
    <groupId>com.manzhushaka</groupId>
    <artifactId>agent-template-pro</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <!-- 面向智能体对话交互的响应式 HTTP API。 -->
  <artifactId>api-chat</artifactId>
  <dependencies>
    <!-- 为对话 API 提供运行时编排服务。 -->
    <dependency>
      <groupId>com.manzhushaka</groupId>
      <artifactId>agent-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 提供响应式 Web 服务与 HTTP 端点能力。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <!-- 校验对话接口的请求参数。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 测试依赖仅在当前模块测试类路径中生效。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
